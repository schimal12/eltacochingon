PORT=3000

# Your public server URL — must be HTTPS (Apple Wallet requirement).
# Baked into every generated pass, so changing it means existing
# passes must be re-added to pick up the new value.
BASE_URL=https://yourdomain.com

# Render Postgres connection string (internal URL if the app and DB
# are Render services in the same region; external + ?sslmode=require
# for anywhere else, e.g. local development).
DATABASE_URL=postgresql://user:password@host/dbname

# From Apple Developer portal → Identifiers → Pass Type IDs
PASS_TYPE_ID=pass.com.yourrestaurant.loyalty

# 10-character Team ID from developer.apple.com → Account → Membership
TEAM_ID=YOURTEAMID

# Displayed on the card, the admin dashboard, and the public landing page
ORG_NAME=Your Restaurant

# Certificate paths (relative to project root, or /etc/secrets/... on Render)
CERT_PATH=./certs/signerCert.pem
KEY_PATH=./certs/signerKey.pem
WWDR_PATH=./certs/wwdr.pem
CERT_PASSPHRASE=           # leave blank if you exported the key without a passphrase

APN_CERT_PATH=./certs/apnCert.pem
APN_KEY_PATH=./certs/apnKey.pem

# Password for the admin dashboard — change this before going live
ADMIN_TOKEN=changeme123

# Shown on the back of the pass (all optional — each has a hardcoded
# fallback in passes/passGenerator.js if unset)
INSTAGRAM_URL=https://www.instagram.com/yourrestaurant/
CONTACT_PHONE=000 000 000
MAPS_URL=https://maps.app.goo.gl/yourlocation
